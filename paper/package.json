{
  "name": "paper2code",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reference implementation of 'A Programming Paradigm for Spatiotemporal Composability' (Shi, Zhang, Cui) — the spacetime calculus and a Cordis-mirroring framework.",
  "scripts": {
    "test": "tsx --test packages/*/test/**/*.test.ts",
    "test:calculus": "tsx --test packages/calculus/test/**/*.test.ts",
    "test:cordis": "tsx --test packages/cordis/test/**/*.test.ts",
    "typecheck": "tsc -p packages/calculus && tsc -p packages/cordis",
    "demo": "tsx packages/cordis/demo/main.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.22.0",
    "typescript": "^5.6.0"
  }
}
